# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yos_crm?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Yos CRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Messaging Providers (add when ready) ─────────────────────────────────────
# WhatsApp Business API
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Twilio (SMS fallback)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# MSG91 (India SMS)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# ── Cron / Automation ─────────────────────────────────────────────────────────
# Secret to protect cron endpoint from unauthorized calls
CRON_SECRET="your-cron-secret-here"
